g(CASE WHEN isnull(email#19) THEN true WHEN NOT if (isnull(email#19)) null else (substring(email#19, -4, 2147483647) = .com) THEN true ELSE false END, Some(Etc/UTC)) AS toprettystring(flag_email_invalido)#451, toprettystring(CASE WHEN isnull(data_cadastro#20) THEN true WHEN Contains(data_cadastro#20, /) THEN true ELSE false END, Some(Etc/UTC)) AS toprettystring(flag_data_cadastro_invalido)#452, toprettystring(CASE WHEN isnull(telefone#21) THEN true WHEN isnull(try_cast(telefone#21 as int)) THEN true ELSE false END, Some(Etc/UTC)) AS toprettystring(flag_telefone_invalido)#453, toprettystring(isnull(cidade#22), Some(Etc/UTC)) AS toprettystring(flag_cidade_invalido)#454]\nInput [6]: [id#17, nome#18, email#19, data_cadastro#20, telefone#21, cidade#22]\n\n(3) CollectLimit\nInput [11]: [toprettystring(id)#444, toprettystring(nome)#445, toprettystring(email)#446, toprettystring(data_cadastro)#447, toprettystring(telefone)#448, toprettystring(cidade)#449, toprettystring(flag_nome_invalido)#450, toprettystring(flag_email_invalido)#451, toprettystring(flag_data_cadastro_invalido)#452, toprettystring(flag_telefone_invalido)#453, toprettystring(flag_cidade_invalido)#454]\nArguments: 21\n\n","sparkPlanInfo":{"nodeName":"CollectLimit","simpleString":"CollectLimit 21","children":[{"nodeName":"WholeStageCodegen (1)","simpleString":"WholeStageCodegen (1)","children":[{"nodeName":"Project","simpleString":"Project [toprettystring(id#17, Some(Etc/UTC)) AS toprettystring(id)#444, toprettystring(nome#18, Some(Etc/UTC)) AS toprettystring(nome)#445, toprettystring(email#19, Some(Etc/UTC)) AS toprettystring(email)#446, toprettystring(data_cadastro#20, Some(Etc/UTC)) AS toprettystring(data_cadastro)#447, toprettystring(telefone#21, Some(Etc/UTC)) AS toprettystring(telefone)#448, toprettystring(cidade#22, Some(Etc/UTC)) AS toprettystring(cidade)#449, toprettystring(isnull(nome#18), Some(Etc/UTC)) AS toprettystring(flag_nome_invalido)#450, toprettystring(CASE WHEN isnull(email#19) THEN true WH